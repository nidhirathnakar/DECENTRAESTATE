# Normalize line endings for text files
* text=auto

# Force LF line endings for source files and JSON artifacts
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sol text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Keep binary files unchanged
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.rar binary
*.exe binary
*.dll binary
